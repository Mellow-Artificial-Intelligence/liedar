{
  "name": "liedar",
  "version": "0.2.0",
  "description": "Lie radar for documents: checks PDFs and images for signs of fraud with Jev, from the terminal or as a library",
  "keywords": ["fraud", "fraud-detection", "document", "forgery", "tampering", "pdf", "invoice", "receipt", "ai", "cli"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colesmcintosh/liedar.git"
  },
  "type": "module",
  "bin": {
    "liedar": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.3"
  },
  "scripts": {
    "check": "bun run src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "smoke:node": "node --experimental-strip-types scripts/node-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "eval": "bun run eval/run.ts",
    "eval:report": "bun run eval/report.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "exifr": "^7.1.3",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
